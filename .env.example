# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Base URL used for auth redirects (Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Cloudflare Turnstile CAPTCHA (see README). Leave empty to turn it off.
# The site key shows the widget; the secret checks comment tokens on the server.
# Sign-up/sign-in/reset tokens are checked by Supabase (Auth > Bot and Abuse Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Google Search Console "HTML tag" verification code (just the content="..." value).
GOOGLE_SITE_VERIFICATION=

# Optional: set to "vercel" after turning on Web Analytics in the Vercel project.
NEXT_PUBLIC_ANALYTICS=
